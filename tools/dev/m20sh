#!/usr/bin/env bash
# Interactive ROS 2 shell inside the running autonomy container (docker-commander-1).
# Everything is pre-sourced: ROS 2 Humble + our /ws overlay + ROS_DOMAIN_ID=42.
#
# From WSL:      bash tools/dev/m20sh
# From Windows:  wsl -d Ubuntu -e bash /mnt/c/GIT/StatefullXOne/m20_autonomy_ws/m20_autonomy_ws/tools/dev/m20sh
#
# Then try:  ros2 topic list · ros2 topic echo /scan · ros2 topic hz /LIDAR/POINTS
#            ros2 run tf2_ros tf2_echo map base_link
C=docker-commander-1
if ! docker ps --format '{{.Names}}' | grep -q "^$C$"; then
  echo "container $C is not running — start the stack first: bash tools/dev/sim_up.sh"
  exit 1
fi
if ! docker ps --format '{{.Names}}' | grep -q '^m20_sim_run$'; then
  echo "!!==============================================================!!"
  echo "!!  WARNING: THE SIM IS NOT RUNNING — there is no robot.         "
  echo "!!  cmd_vel/goals will go nowhere. Start it in another terminal: "
  echo "!!    wsl -d Ubuntu -e bash <repo>/tools/dev/sim_up.sh           "
  echo "!!==============================================================!!"
fi
exec docker exec -it $C bash -c '
  cat > /tmp/m20rc <<"RC"
source /opt/ros/humble/setup.bash
source /ws/install/setup.bash
export ROS_DOMAIN_ID=42
export ROS_DISCOVERY_SERVER=127.0.0.1:11811
export ROS_SUPER_CLIENT=TRUE
export PS1="[m20] \w \$ "
eval "$(register-python-argcomplete3 ros2 2>/dev/null || register-python-argcomplete ros2 2>/dev/null)" || true
RC
  echo "M20 dev shell — ROS 2 Humble sourced, domain 42. Configs in /cfg. Type exit to leave."
  cd /cfg 2>/dev/null || cd /
  exec bash --rcfile /tmp/m20rc -i'
