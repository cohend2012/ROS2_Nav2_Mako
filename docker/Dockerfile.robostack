# VERIFICATION image: the same /ws layout, entry scripts and packages as docker/Dockerfile,
# but ROS 2 Humble + Nav2 from RoboStack (conda-forge) instead of packages.ros.org.
# Use it where apt/packages.ros.org is unavailable (locked-down CI, sandboxes) to check the
# container packaging end to end. The ROBOT image is docker/Dockerfile.
#
#   DOCKER_BUILDKIT=1 docker build --network host -f docker/Dockerfile.robostack \
#     [--build-arg HTTPS_PROXY=...] [--secret id=ca,src=<ca-bundle.crt>] -t m20_autonomy:robostack .
FROM mambaorg/micromamba:1.5.10-jammy
USER root
SHELL ["/bin/bash", "-c"]
ARG HTTPS_PROXY=""
ENV HTTPS_PROXY=${HTTPS_PROXY} https_proxy=${HTTPS_PROXY}
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export SSL_CERT_FILE=/run/secrets/ca REQUESTS_CA_BUNDLE=/run/secrets/ca \
         CONDA_SSL_VERIFY=/run/secrets/ca; fi; \
    micromamba create -y -n ros -c robostack-staging -c conda-forge python=3.11 \
      ros-humble-ros-base ros-humble-nav2-bringup ros-humble-nav2-collision-monitor \
      ros-humble-nav2-smac-planner ros-humble-nav2-mppi-controller \
      ros-humble-nav2-rotation-shim-controller ros-humble-nav2-regulated-pure-pursuit-controller \
      ros-humble-slam-toolbox ros-humble-pointcloud-to-laserscan ros-humble-tf2-ros-py \
      ros-humble-rosidl-default-generators "empy=3.3.4" colcon-common-extensions cmake make \
      compilers onnxruntime pyyaml pillow numpy openai \
    && micromamba clean -a -y
# /opt/ros/humble/setup.bash shim so the SAME entry scripts work unchanged
RUN mkdir -p /opt/ros/humble && printf '%s\n' \
      'eval "$(micromamba shell hook -s bash)" >/dev/null 2>&1 || true' \
      'export MAMBA_ROOT_PREFIX=/opt/conda; micromamba activate ros 2>/dev/null || source /opt/conda/envs/ros/setup.bash' \
      > /opt/ros/humble/setup.bash
WORKDIR /ws
COPY src/m20_msgs src/m20_msgs
COPY src/m20_missions src/m20_missions
COPY src/m20_navigation src/m20_navigation
COPY src/m20_ai_nav src/m20_ai_nav
COPY src/m20_agent src/m20_agent
# NO --symlink-install: conda's setuptools rejects colcon's 'develop --editable'
# ("option --editable not recognized"), and a deploy image should copy anyway.
# NO '| tail': a pipe hid this exact failure once (Engineering Rule 1). Every package
# must be installed, checked explicitly.
RUN source /opt/ros/humble/setup.bash && \
    colcon build --cmake-args -DPython_EXECUTABLE=/opt/conda/envs/ros/bin/python \
      -DPython3_EXECUTABLE=/opt/conda/envs/ros/bin/python && \
    for p in m20_msgs m20_missions m20_navigation m20_ai_nav m20_agent; do \
      test -d install/$p || { echo "MISSING PACKAGE $p"; exit 1; }; done && \
    test -f install/m20_navigation/share/m20_navigation/config/collision_monitor.yaml && \
    test -f install/m20_ai_nav/share/m20_ai_nav/models/m20_nav_policy.onnx
COPY tools/nav/apply_overlay.py /ws/tools/apply_overlay.py
COPY tools/slam/localization_params.yaml tools/slam/mapper_params.yaml /ws/config/slam/
COPY docker/nav_entry.sh /nav_entry.sh
COPY docker/perception_entry.sh /perception_entry.sh
COPY docker/agent_entry.sh /agent_entry.sh
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/healthcheck.py /healthcheck.py
COPY tools/ai_nav/ros_smoke /smoke
RUN chmod +x /entrypoint.sh /nav_entry.sh /perception_entry.sh /agent_entry.sh
ENV HTTPS_PROXY="" https_proxy=""
ENTRYPOINT ["/entrypoint.sh"]
