{
  "name": "m20_autonomy",
  "build": { "dockerfile": "../docker/Dockerfile", "context": ".." },
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind",
  "workspaceFolder": "/ws",
  "runArgs": ["--network=host", "--ipc=host"],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-iot.vscode-ros", "ms-azuretools.vscode-docker"]
    }
  },
  "postCreateCommand": "pip install pytest --break-system-packages || pip install pytest"
}
